<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Scvx</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Deliberately references nothing: not KSA, not the game's assemblies.
       The SCvx solve must be pure computation over plain data so it can run off
       the main thread, and keeping the dependency out at project level makes a
       violation a compile error rather than a review comment. -->

</Project>
