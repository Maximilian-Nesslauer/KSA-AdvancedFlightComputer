<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Scvx</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The native solver travels with the managed library, same as Gfold.Core:
         anything referencing Scvx.Core gets ecos.dll beside it, and the
         DllImport resolver loads it from there. Shared with gfold rather than
         vendored twice — it is the same binary. -->
    <None Include="..\..\gfold\native\ecos.dll" Link="ecos.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Deliberately references no other project and no game assembly. The SCvx
       solve must be pure computation over plain data so it can run off the main
       thread, and keeping that out at project level makes a violation a compile
       error rather than a review comment. -->

</Project>
