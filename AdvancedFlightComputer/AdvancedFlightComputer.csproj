<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <KsaDir Condition="'$(KsaDir)' == ''">$(MSBuildProjectDirectory)\..\..\..\refs\game</KsaDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
    <PackageReference Include="StarMap.API" Version="0.5.4" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="KSA">
      <HintPath>$(KsaDir)\KSA.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Numerics">
      <HintPath>$(KsaDir)\Brutal.Numerics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Logging">
      <HintPath>$(KsaDir)\Brutal.Logging.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CommunityToolkit.HighPerformance">
      <HintPath>$(KsaDir)\CommunityToolkit.HighPerformance.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.ImGui">
      <HintPath>$(KsaDir)\Brutal.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core">
      <HintPath>$(KsaDir)\Brutal.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Strings">
      <HintPath>$(KsaDir)\Brutal.Strings.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Localization">
      <HintPath>$(KsaDir)\Brutal.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepuUtilities">
      <HintPath>$(KsaDir)\BepuUtilities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- KsaVehicleHeight bounds each collider's own Bepu shape to find the touchdown point. -->
    <Reference Include="BepuPhysics">
      <HintPath>$(KsaDir)\BepuPhysics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Planet.Render.Core">
      <HintPath>$(KsaDir)\Planet.Render.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- The game reads these asset files through the "assets" list of mod.toml. -->
  <ItemGroup>
    <ModPayloadFile Include="Content\*.xml" TargetPath="Content/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Features\Guidance\Numerics\**\*.cs;Features\Guidance\Conic\**\*.cs;Features\Guidance\Gfold\**\*.cs;Features\Guidance\Scvx\**\*.cs" />
    <ProjectReference Include="Features\Guidance\Numerics\AdvancedFlightComputer.Guidance.Numerics.csproj" />
    <ProjectReference Include="Features\Guidance\Conic\AdvancedFlightComputer.Guidance.Conic.csproj" />
    <ProjectReference Include="Features\Guidance\Gfold\AdvancedFlightComputer.Guidance.Gfold.csproj" />
    <ProjectReference Include="Features\Guidance\Scvx\AdvancedFlightComputer.Guidance.Scvx.csproj" />
  </ItemGroup>

  <!-- The headless test mod asserts against internal feature code (OrbitManeuvers). -->
  <ItemGroup>
    <InternalsVisibleTo Include="AdvancedFlightComputer.HarnessTests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="mod.toml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Deploy into the game's mods folder, plus the worktree-safety and game-is-running
       guards. The @(ModPayloadFile) items declared above are picked up automatically. -->
  <Import Project="..\build\ModDeploy.targets" />
  <Import Project="..\build\GuidancePayload.targets" />

  <!-- LOCAL TEST PARTS (Content\Testing): a Debug build that deploys copies them in and adds them to the
       deployed mod.toml's assets. Release packages carry only Content\*.xml and the repo's mod.toml, so
       players never get them. -->
  <Target Name="DeployTestParts" AfterTargets="CopyToMods"
          Condition="'$(DeployToMods)' == 'true' AND '$(Configuration)' == 'Debug'">
    <ItemGroup>
      <_TestPart Include="Content\Testing\*.xml" />
    </ItemGroup>
    <Copy SourceFiles="@(_TestPart)" DestinationFolder="$(ModDeployDir)Content\" />
    <PropertyGroup>
      <_TestPartAssets>@(_TestPart->'"Content/%(Filename)%(Extension)", ', '')</_TestPartAssets>
      <_DeployedModToml>$([System.IO.File]::ReadAllText('$(ModDeployDir)mod.toml'))</_DeployedModToml>
      <_DeployedModToml>$(_DeployedModToml.Replace('assets = [ ', 'assets = [ $(_TestPartAssets)'))</_DeployedModToml>
    </PropertyGroup>
    <WriteLinesToFile File="$(ModDeployDir)mod.toml" Lines="$(_DeployedModToml.TrimEnd())" Overwrite="true" />
    <Message Importance="high" Text="$(MSBuildProjectName): Debug deploy, local test parts added: @(_TestPart->'%(Filename)', ', ')." />
  </Target>

  <Target Name="PackageRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ReleaseDir>$(OutputPath)release\$(AssemblyName)\</ReleaseDir>
      <ZipPath>$(OutputPath)$(AssemblyName).zip</ZipPath>
    </PropertyGroup>
    <RemoveDir Directories="$(OutputPath)release" />
    <MakeDir Directories="$(ReleaseDir)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(ReleaseDir)" />
    <Copy SourceFiles="mod.toml" DestinationFolder="$(ReleaseDir)" />
    <Copy SourceFiles="@(ModPayloadFile)" DestinationFiles="@(ModPayloadFile->'$(ReleaseDir)%(TargetPath)')" />
    <ZipDirectory SourceDirectory="$(OutputPath)release" DestinationFile="$(ZipPath)" Overwrite="true" />
    <RemoveDir Directories="$(OutputPath)release" />
    <Message Importance="high" Text="Release packaged: $(ZipPath)" />
  </Target>

</Project>
