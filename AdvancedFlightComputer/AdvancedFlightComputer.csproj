<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <KsaDir Condition="'$(KsaDir)' == ''">$(MSBuildProjectDirectory)\..\..\..\refs\game</KsaDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="StarMap.API" Version="0.3.6" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="KSA">
      <HintPath>$(KsaDir)\KSA.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Numerics">
      <HintPath>$(KsaDir)\Brutal.Core.Numerics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Logging">
      <HintPath>$(KsaDir)\Brutal.Core.Logging.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CommunityToolkit.HighPerformance">
      <HintPath>$(KsaDir)\CommunityToolkit.HighPerformance.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.ImGui">
      <HintPath>$(KsaDir)\Brutal.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Strings">
      <HintPath>$(KsaDir)\Brutal.Core.Strings.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Localization">
      <HintPath>$(KsaDir)\Brutal.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepuUtilities">
      <HintPath>$(KsaDir)\BepuUtilities.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PatchFile Include="Patches\*.xml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Features\Guidance\Numerics\**\*.cs;Features\Guidance\Gfold\**\*.cs;Features\Guidance\Scvx\**\*.cs" />
    <ProjectReference Include="Features\Guidance\Numerics\AdvancedFlightComputer.Guidance.Numerics.csproj" />
    <ProjectReference Include="Features\Guidance\Gfold\AdvancedFlightComputer.Guidance.Gfold.csproj" />
    <ProjectReference Include="Features\Guidance\Scvx\AdvancedFlightComputer.Guidance.Scvx.csproj" />
  </ItemGroup>

  <!-- The headless test mod asserts against internal feature code (OrbitManeuvers). -->
  <ItemGroup>
    <InternalsVisibleTo Include="AdvancedFlightComputer.HarnessTests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="mod.toml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Deploy into the game's mods folder, plus the worktree-safety and game-is-running
       guards. The @(PatchFile) items declared above are picked up automatically. -->
  <Import Project="..\build\ModDeploy.targets" />
  <Import Project="..\build\GuidancePayload.targets" />

  <Target Name="PackageRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ReleaseDir>$(OutputPath)release\$(AssemblyName)\</ReleaseDir>
      <ZipPath>$(OutputPath)$(AssemblyName).zip</ZipPath>
    </PropertyGroup>
    <RemoveDir Directories="$(OutputPath)release" />
    <MakeDir Directories="$(ReleaseDir)Patches\" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(ReleaseDir)" />
    <Copy SourceFiles="mod.toml" DestinationFolder="$(ReleaseDir)" />
    <Copy SourceFiles="@(PatchFile)" DestinationFolder="$(ReleaseDir)Patches\" />
    <Copy SourceFiles="@(ModPayloadFile)" DestinationFiles="@(ModPayloadFile->'$(ReleaseDir)%(TargetPath)')" />
    <ZipDirectory SourceDirectory="$(OutputPath)release" DestinationFile="$(ZipPath)" Overwrite="true" />
    <RemoveDir Directories="$(OutputPath)release" />
    <Message Importance="high" Text="Release packaged: $(ZipPath)" />
  </Target>

</Project>
