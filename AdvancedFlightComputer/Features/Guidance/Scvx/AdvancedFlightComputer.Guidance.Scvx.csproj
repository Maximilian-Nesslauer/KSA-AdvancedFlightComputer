<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../../build/GuidanceNative.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AdvancedFlightComputer.Guidance.Scvx</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Numerics/AdvancedFlightComputer.Guidance.Numerics.csproj" />
    <!-- The convex ascent solves its subproblems with Clarabel, which the G-FOLD project binds. -->
    <ProjectReference Include="../Gfold/AdvancedFlightComputer.Guidance.Gfold.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(GuidanceNativeDir)$(GuidanceHostRid)/$(GuidanceHostScs)" Link="$(GuidanceHostScs)"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('$(GuidanceNativeDir)$(GuidanceHostRid)/$(GuidanceHostScs)')" />
  </ItemGroup>
</Project>
