<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../../build/GuidanceNative.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AdvancedFlightComputer.Guidance.Gfold</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(GuidanceNativeDir)$(GuidanceHostRid)/$(GuidanceHostClarabel)" Link="$(GuidanceHostClarabel)"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('$(GuidanceNativeDir)$(GuidanceHostRid)/$(GuidanceHostClarabel)')" />
  </ItemGroup>
</Project>
