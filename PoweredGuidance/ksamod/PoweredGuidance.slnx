<Solution>
  <!-- The whole shipped product in one view: the mod and everything it links. The
       per-subsystem solutions (gfold/Gfold.slnx, scvx/Scvx.slnx, lib/Lib.slnx) still
       exist and are the place to work on those alone - a solution is a view, not
       ownership. The Consoles are deliberately NOT here: they are validation
       harnesses that live beside their reference data and build scripts.
       convtest was dropped when this subtree was merged into AdvancedFlightComputer;
       tools/ did not come across. -->
  <Project Path="PoweredGuidance.csproj" />
  <Project Path="../gfold/Gfold.Core/Gfold.Core.csproj" />
  <Project Path="../scvx/Scvx.Core/Scvx.Core.csproj" />
  <Project Path="../lib/PoweredGuidance.Numerics/PoweredGuidance.Numerics.csproj" />
</Solution>
