# Build output
[Bb]in/
[Oo]bj/

# Test / coverage output
[Tt]est[Rr]esults/
CoverageReport/
*.cobertura.xml

# IDE / editor state
.idea/
.vs/
*.user
*.suo
*.DotSettings.user
*.userprefs

# Local Claude / agent settings (never publish)
.claude/

# Native build output — the .dll/.lib/.pdb are rebuilt from the vendored C
# sources, which ARE committed. (scs.pdb alone is 1.4 MB.)
#   gfold/native/ <- gfold/build-ecos.ps1 from gfold/ecos/
#   scvx/native/  <- scvx/build-scs.ps1  from scvx/scs/
gfold/native/
scvx/native/

# Generated solver output
gfold_*.csv
gfold/gfold_*.csv
gfold/python_ref/*.csv

# SCvx debug dumps: whole cone programs written out to be re-solved in Python
# (see scvx/python_ref/cone_check.py). Hundreds of KB, regenerated on demand by
# `python canon_dump.py`.
scvx/python_ref/cone_dump.txt
scvx/python_ref/canon_dump.txt

# C# OUTPUT, not a fixture: written by `Scvx.Console --loop` for plot_compare.py.
# Regenerated by any run, so committing it just churns the diff.
scvx/python_ref/loop_cs.csv

# NOT ignored, deliberately, unlike gfold/python_ref/*.csv above:
# scvx/python_ref/dyn_ref.csv, sub_ref.csv and loop_ref.csv are small validation
# FIXTURES, not outputs — they are the JAX/CVXPY oracles the C# checks diff
# against. Committing them means `Scvx.Console --verbose`, `--sub-scs`, `--loop`
# and `--rh` run standalone; regenerating them needs JAX + cvxpy, which is a
# heavy dependency to force on anyone who just wants to run the tests.
# loop_ref.csv also carries the `# consts` line the drift guard asserts against.

# Python virtualenv / cache (gfold/python_ref)
gfold/python_ref/.venv/
__pycache__/
*.pyc
